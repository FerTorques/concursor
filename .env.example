# Variables de entorno para Supabase
# Copia este archivo como .env.local para desarrollo local
# y configúralas en el panel de Vercel (Project Settings -> Environment Variables)

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica-aqui

# Nombre de la tabla (por defecto 'cargos')
VITE_SUPABASE_TABLE=cargos
